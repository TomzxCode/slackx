// .sdlc/context/schema.dbml
// Generated by /sync-sdlc on 2026-10-13.
// Detailed companion to the Mermaid erDiagram in architecture.md.
// Source of truth: src/slackx/storage.py (constants SCHEMA and SEARCH_SCHEMA).
// One SQLite database file per Slack workspace, under ~/.cache/slackx.

Project slackx {
  database_type: 'SQLite'
  Note: '''
  Local per-workspace cache for Slack threads, messages, users, and channels,
  plus read markers and key/value metadata.
  Timestamps (thread ts, message ts, last_read_ts) are Slack string timestamps.
  REAL columns store Unix epoch seconds produced by Python time.time().
  payload columns hold the raw Slack JSON object as a text blob.
  '''
}

Table threads {
  channel      TEXT [not null, note: 'Slack channel id (C/G/D prefix)']
  thread_ts    TEXT [not null, note: 'Parent message ts identifying the thread']
  last_fetched REAL [not null, note: 'Unix epoch seconds of last successful fetch']
  latest_reply TEXT [null, note: 'ts of the most recent known reply']

  indexes {
    (channel, thread_ts) [pk]
  }

  Note: 'One row per cached thread. Cached state used to decide what to refetch.'
}

Table messages {
  channel   TEXT [not null]
  thread_ts TEXT [not null, note: 'Parent thread ts; equals ts for the parent message']
  ts        TEXT [not null]
  user      TEXT [null, note: 'Author user id; null for system or bot-less messages']
  text      TEXT [null, note: 'Plain message text, indexed by messages_fts']
  payload   TEXT [not null, note: 'Raw Slack message JSON']

  indexes {
    (channel, thread_ts, ts) [pk]
    (channel, thread_ts, ts) [name: 'idx_messages_thread']
  }

  Note: '''
  One row per cached message. Foreign key (channel, thread_ts) references
  threads(channel, thread_ts). Deleted messages are marked in payload rather
  than removed.
  '''
}

Note messages_fts {
  '''
  Full-text search index over messages, defined in SEARCH_SCHEMA:
  CREATE VIRTUAL TABLE messages_fts USING fts5(
      text, content='messages', content_rowid='rowid',
      tokenize='porter unicode61');
  It is an external-content FTS5 table that indexes messages.text and is kept
  in sync by three triggers over messages:
  - messages_fts_insert: AFTER INSERT ON messages, inserts (new.rowid, new.text).
  - messages_fts_delete: AFTER DELETE ON messages, inserts the 'delete' command
    row for (old.rowid, old.text).
  - messages_fts_update: AFTER UPDATE OF text ON messages, deletes the old
    (old.rowid, old.text) and inserts (new.rowid, new.text).
  '''
}

Note fts5_optional {
  '''
  FTS5 is an optional SQLite compile-time feature. SEARCH_SCHEMA is applied
  separately from SCHEMA so that a SQLite build without FTS5 still caches and
  browses normally; search then degrades to returning no results.
  '''
}

Table users {
  id         TEXT [pk, not null, note: 'Slack user id']
  name       TEXT [null, note: 'Slack username (handle)']
  real_name  TEXT [null]
  fetched_at REAL [not null, note: 'Unix epoch seconds of last fetch']
  payload    TEXT [not null, note: 'Raw Slack user JSON']

  indexes {
    fetched_at [name: 'idx_users_fetched_at']
  }

  Note: 'One row per cached workspace user.'
}

Table channels {
  id         TEXT [pk, not null, note: 'Slack channel id (C/G/D prefix)']
  name       TEXT [null]
  is_private INTEGER [null, note: 'Boolean stored as 0 or 1']
  fetched_at REAL [not null, note: 'Unix epoch seconds of last fetch']
  payload    TEXT [not null, note: 'Raw Slack channel JSON']

  indexes {
    fetched_at [name: 'idx_channels_fetched_at']
  }

  Note: 'One row per cached channel, group, or direct message.'
}

Table meta {
  key   TEXT [pk, not null]
  value TEXT [not null]

  Note: 'Key/value store for cache-level bookkeeping such as incremental state.'
}

Table read_markers {
  reader       TEXT [not null, note: 'Reader identity the marker belongs to']
  channel      TEXT [not null]
  thread_ts    TEXT [not null]
  last_read_ts TEXT [not null, note: 'Slack ts of the last read message']
  updated_at   REAL [not null, note: 'Unix epoch seconds of last update']

  indexes {
    (reader, channel, thread_ts) [pk]
    (reader, channel) [name: 'idx_read_markers_reader']
  }

  Note: 'Last-read pointer per reader and thread.'
}

Ref: messages.(channel, thread_ts) > threads.(channel, thread_ts)
